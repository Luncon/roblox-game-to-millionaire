{
  "name": "civilization-battlefield",
  "version": "0.0.0",
  "private": true,
  "description": "Development tooling for a Luau civilization-building Roblox game",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "setup:tools": "node scripts/install-dev-tools.mjs",
    "lint": "node scripts/check-luau.mjs lint",
    "lint:all": "node scripts/check-luau.mjs lint --all",
    "format": "node scripts/check-luau.mjs format",
    "format:check": "node scripts/check-luau.mjs format:check",
    "format:check:all": "node scripts/check-luau.mjs format:check --all",
    "test": "node --test scripts/tests/*.test.mjs && npm run test:syntax && npm run check:skills && npm run check:miniature",
    "test:syntax": "node scripts/run-lune.mjs .lune/smoke.luau",
    "check:dev": "npm run check && npm run lint && npm run format:check && npm test",
    "check:skills": "node scripts/check-weapon-skills.mjs",
    "check:miniature": "node scripts/check-miniature-game.mjs",
    "build:test-project": "node scripts/create-test-project.mjs",
    "build:miniature-tests": "node scripts/create-miniature-test-project.mjs",
    "build:miniature-game-tests": "node scripts/create-miniature-game-tests.mjs",
    "openspec": "openspec",
    "setup:openspec": "openspec init --tools codex --profile core --no-animation",
    "check": "openspec validate --all --strict --no-interactive"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.1"
  }
}
