return function()
 local Game=game.ServerScriptService.Game
 local Rules=require(Game.MedicalRules)
 local Recovery=require(Game.YardRecovery)
 local Planner=require(Game.MedicPlanner)
 local Camp=require(game.ReplicatedStorage.Shared.TrainingCampConfig)
 local n=0
 local function test(name,fn)fn();n+=1;print("PASS: "..name)end
 local function actor(kind,owner,hp,x,z)
  local rig={Name=kind,GetAttribute=function(_,key)return if key=="ArmySlot" then kind else nil end}
  return {rig=rig,humanoid={Health=hp or 50,MaxHealth=100},kind=kind or "warrior",ownerId=owner or 1,civilizationId="sparta",plotId=1,alive=true,claimed=true,position=Vector3.new(x or 0,2.15,z or 0)}
 end
 local state={hospitalLevel=1,trainingLevel=1}
 local function visible()return true end
 local function plan(record,m,actors,order,home,forward,now,safe,sight)
  return Planner.step(record,m,actors,order,home,forward,now,safe,state,sight or visible)
 end
 test("proximity contacts choose one nearest troop rather than health priority",function()
  local m=actor("medic",1,100)
  local near=actor("ranged",1,90,10,2)
  local farther=actor("warrior",1,10,10,2.5)
  local from=m.position+Vector3.new(0,1,0)
  local to=Vector3.new(10,from.Y,0)
  assert(Rules.nearest(m,{farther,near},state,from,to,3)==near)
  near.position=farther.position
  assert(Rules.nearest(m,{farther,near},state,from,to,3)==near)
 end)
 test("medical eligibility excludes foreign players workers dead full and stale claim",function()
  local a=actor("warrior");assert(Rules.patient(a,1,state))
  for _,kind in {"player","farmer","unknown"}do local b=actor(kind);assert(not Rules.patient(b,1,state))end
  assert(not Rules.patient(actor("warrior",2),1,state));assert(not Rules.patient(actor("warrior",1,0),1,state));assert(not Rules.patient(actor("warrior",1,100),1,state))
  assert(not Rules.patient(a,1,{hospitalLevel=0}));a.neutral=true;assert(not Rules.patient(a,1,state))
 end)
 test("healing clamps simultaneous ticks and rejects dead or replaced life",function()
  local a=actor("warrior",1,98);assert(Rules.apply(a,a.humanoid,12)==2);assert(Rules.apply(a,a.humanoid,5)==0)
  a.humanoid.Health=0;assert(Rules.apply(a,a.humanoid,12)==0)
  a.humanoid.Health=50;assert(Rules.apply(a,{},12)==0 and a.humanoid.Health==50)
 end)
 test("patient ranking uses fraction deficit distance stable slot and excludes self",function()
  local source=actor("medic");local a,b=actor("warrior",1,30,10),actor("ranged",1,40,2)
  assert(Rules.choose(source,{source,b,a},state,45)==a)
  a.humanoid.Health=40;assert(Rules.choose(source,{a,b},state,45)==b)
  a.position=b.position;assert(Rules.choose(source,{a,b},state,45)==b)
  b.humanoid.MaxHealth=200;b.humanoid.Health=80;assert(Rules.choose(source,{a,b},state,45)==b)
  a.position=Vector3.new(100,0,0);b.humanoid.Health=200;assert(not Rules.choose(source,{source,a,b},state,45))
 end)
 test("yard first tick waits two undamaged seconds then one per second without catchup",function()
  local h={Health=50,MaxHealth=100};local r={}
  assert(not Recovery.step(r,h,true,0,nil));assert(not Recovery.step(r,h,true,1,nil))
  assert(Recovery.step(r,h,true,2,nil));assert(not Recovery.step(r,h,true,2.2,nil))
  assert(Recovery.step(r,h,true,3,nil));assert(not Recovery.step(r,h,true,20,nil))
  assert(not Recovery.step(r,h,true,21,nil));assert(Recovery.step(r,h,true,22,nil))
 end)
 test("yard clocks reset on leave damage authority full health and new life",function()
  local h={Health=50,MaxHealth=100};local r={}
  Recovery.step(r,h,true,0,nil);Recovery.step(r,h,true,1,nil);h.Health=40
  assert(not Recovery.step(r,h,true,2,nil));assert(not Recovery.step(r,h,true,3,nil));assert(Recovery.step(r,h,true,4,nil))
  Recovery.step(r,h,false,4.1,nil);assert(not Recovery.step(r,h,true,5,nil))
  h.Health=100;assert(not Recovery.step(r,h,true,6,nil));h.Health=90;assert(not Recovery.step(r,h,true,7,nil))
  assert(not Recovery.step(r,{Health=40,MaxHealth=100},true,8,nil))
 end)
 test("physical yard rejects outside margin and airborne positions and uses medic ring six",function()
  assert(Recovery.contains(Camp.center+Vector3.new(0,2.15,9)))
  assert(not Recovery.contains(Camp.center+Vector3.new(14,2.15,0)))
  assert(not Recovery.contains(Camp.center+Vector3.new(0,12,0)))
  assert(Camp.arrivalIndex("medic")==6 and Camp.arrivalIndex("camp")==8)
 end)
 test("healthy fighters retain the backline fallback while Hold remains stationary",function()
  local m=actor("medic",1,80,0,20);local f=actor("warrior",1,100,0,0);local enemy=actor("warrior",2,80,0,-20)
  local p=plan({},m,{m,f,enemy},"advance",Vector3.new(0,2,45),Vector3.new(0,0,-1),0,function(p)return p end)
  assert(math.abs(p.goal.Z-12)<.001)
  p=plan({},m,{m,f,enemy},"hold",Vector3.zero,Vector3.new(0,0,-1),0,function(p)return p end)
  assert(p.goal==nil and not p.retreat)
 end)
 test("a fresh distant replacement cannot pull the medic away from a healable patient",function()
  local m=actor("medic",1,100,0,20);local wounded=actor("warrior",1,40,0,0)
  local replacement=actor("ranged",1,100,0,600)
  local p=plan({},m,{m,wounded,replacement},"advance",Vector3.new(0,2,45),Vector3.new(0,0,-1),0,function(p)return p end)
  assert(p.patient==wounded and p.goal==nil and p.facing==wounded.position)
 end)
 test("out-of-range wounded troops take movement priority over the army centroid",function()
  local m=actor("medic",1,100);local wounded=actor("warrior",1,40,90,0)
  local replacement=actor("ranged",1,100,0,600)
  local p=plan({},m,{m,wounded,replacement},"advance",Vector3.new(0,2,45),Vector3.new(0,0,-1),0,function(p)return p end)
  assert(p.patient==wounded and p.goal and (p.goal-wounded.position).Magnitude<=45 and p.goal.X>0)
 end)
 test("seeking chooses a side approach instead of walking into an enemy",function()
  local m=actor("medic",1,100);local wounded=actor("warrior",1,40,90,0);local enemy=actor("warrior",2,100,60,0)
  local p=plan({},m,{m,wounded,enemy},"advance",Vector3.zero,Vector3.new(0,0,-1),0,function(p)return p end)
  assert(p.patient==wounded and p.goal and (p.goal-enemy.position).Magnitude>=18)
  local leg=p.goal-m.position;local t=math.clamp((enemy.position-m.position):Dot(leg)/leg:Dot(leg),0,1)
  assert((m.position+leg*t-enemy.position).Magnitude>=12)
 end)
 test("visible patients beat blocked critical candidates without seeking a foreign troop",function()
  local m=actor("medic",1,100);local blocked=actor("warrior",1,1,12,0)
  local good=actor("ranged",1,50,0,20);local foreign=actor("warrior",2,1,0,30)
  local p=plan({},m,{m,blocked,good,foreign},"advance",Vector3.zero,Vector3.new(0,0,-1),0,function(p)return p end,function(_,target)return target==good end)
  assert(p.patient==good and not p.goal)
 end)
 test("death replacement and full recovery immediately invalidate the seeking patient",function()
  local m=actor("medic",1,100);local wounded=actor("warrior",1,40,80,0);local record={}
  local function step(a)return plan(record,m,{m,a},"advance",Vector3.zero,Vector3.new(0,0,-1),0,function(p)return p end)end
  assert(step(wounded).patient==wounded)
  wounded.humanoid.Health=0;assert(not step(wounded).patient)
  local replacement=actor("warrior",1,100,80,0);assert(not step(replacement).patient)
  replacement.humanoid.Health=40;assert(step(replacement).patient==replacement)
  replacement.humanoid.Health=100;assert(not step(replacement).patient)
 end)
 test("unreachable healing positions fall back safely and Hold never chases wounded troops",function()
  local m=actor("medic",1,100);local wounded=actor("warrior",1,40,80,0)
  local p=plan({},m,{m,wounded},"advance",Vector3.zero,Vector3.new(0,0,-1),0,function()return nil end)
  assert(not p.goal and not p.patient)
  p=plan({},m,{m,wounded},"hold",Vector3.zero,Vector3.new(0,0,-1),0,function(p)return p end)
  assert(not p.goal and not p.patient and not p.retreat)
 end)
 test("nearby enemies interrupt patient seeking before a healing goal is chosen",function()
  local m=actor("medic",1,100);local wounded=actor("warrior",1,40,80,0);local enemy=actor("warrior",2,100,0,-8)
  local p=plan({},m,{m,wounded,enemy},"advance",Vector3.zero,Vector3.new(0,0,-1),0,function(p)return p end)
  assert(p.retreat and not p.patient and p.goal and (p.goal-m.position).Magnitude<=18)
 end)
 test("a healthy replacement outside the arena uses the safe rally fallback",function()
  local m=actor("medic",1,100);local replacement=actor("warrior",1,100,0,600);local home=Vector3.new(0,2.15,45)
  local p=plan({},m,{m,replacement},"advance",home,Vector3.new(0,0,-1),0,function(point)return if point==home then point else nil end)
  assert(p.goal==home and not p.patient)
 end)
 test("medic retreat is threat first bounded and cannot restart until safe",function()
  local m=actor("medic",1,80,0,0);local e=actor("warrior",2,80,0,-8);local ally=actor("warrior",1,100,20,0);local record={}
  local safe=function(p)return p end
  local p=plan(record,m,{m,e,ally},"advance",Vector3.new(0,2,45),Vector3.new(0,0,-1),0,safe)
  assert(p.retreat and p.goal.Z>0 and (p.goal-m.position).Magnitude<=18)
  p=plan(record,m,{m,e,ally},"advance",Vector3.zero,Vector3.new(0,0,-1),4,safe)
  assert(p.retreat and not p.goal)
  p=plan(record,m,{m,e,ally},"advance",Vector3.zero,Vector3.new(0,0,-1),5,safe);assert(not p.goal)
  e.position=Vector3.new(0,2,-30);p=plan(record,m,{m,e,ally},"advance",Vector3.new(0,2,45),Vector3.new(0,0,-1),6,safe);assert(not p.retreat)
 end)
 test("isolated medics keep withdrawing after three seconds and rejoin fresh fighters",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-8);local fresh=actor("ranged",1,100,0,500);local record={}
  local function step(time,list)return plan(record,m,list,"advance",Vector3.new(0,2.15,550),Vector3.new(0,0,-1),time,function(p)return p end)end
  local p=step(0,{m,e,fresh});assert(p.withdrawing and p.goal.Z>100)
  p=step(5,{m,e,fresh});assert(p.withdrawing and p.goal.Z>100)
  m.position=Vector3.new(0,2.15,480);p=step(6,{m,e,fresh});assert(not p.withdrawing)
 end)
 test("a lone medic withdraws to its own waiting area and Hold overrides withdrawal",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-8);local home=Vector3.new(0,2.15,550)
  local p=plan({},m,{m,e},"advance",home,Vector3.new(0,0,-1),5,function(p)return p end)
  assert(p.withdrawing and p.goal==home)
  p=plan({},m,{m,e},"hold",home,Vector3.new(0,0,-1),5,function(p)return p end);assert(not p.goal)
 end)
 test("support rally works with no fighters and rejected routes never produce movement",function()
  local m=actor("medic");local home=Vector3.new(0,2.15,45)
  local p=plan({},m,{m},"advance",home,Vector3.new(0,0,-1),0,function(p)return p end)
  assert(p.goal==home)
  p=plan({},m,{m},"advance",home,Vector3.new(0,0,-1),0,function()return nil end)
  assert(not p.goal)
 end)
 return n
end
