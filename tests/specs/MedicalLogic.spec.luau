return function()
 local Game=game.ServerScriptService.Game
 local Rules=require(Game.MedicalRules)
 local Recovery=require(Game.YardRecovery)
 local Planner=require(Game.MedicPlanner)
 local Camp=require(game.ReplicatedStorage.Shared.TrainingCampConfig)
 local n=0
 local function test(name,fn)fn();n+=1;print("PASS: "..name)end
 local function actor(kind,owner,hp,x,z)
  local rig={Name=kind,GetAttribute=function(_,key)return if key=="ArmySlot" then kind else nil end}
  return {rig=rig,humanoid={Health=hp or 50,MaxHealth=100},kind=kind or "warrior",ownerId=owner or 1,civilizationId="sparta",plotId=1,alive=true,claimed=true,position=Vector3.new(x or 0,2.15,z or 0)}
 end
 local state={hospitalLevel=1,trainingLevel=1}
 local function visible()return true end
 local function plan(record,m,actors,onField,safe,order)
  return Planner.step(m,actors,order or "advance",Vector3.new(0,2.15,0),Vector3.new(0,0,-1),onField,
   safe or function(p)return p end,function(p)return Vector3.new(p.X,0,p.Z).Magnitude<=250 end)
 end
 test("proximity contacts choose one nearest troop rather than health priority",function()
  local m=actor("medic",1,100)
  local near=actor("ranged",1,90,10,2)
  local farther=actor("warrior",1,10,10,2.5)
  local from=m.position+Vector3.new(0,1,0)
  local to=Vector3.new(10,from.Y,0)
  assert(Rules.nearest(m,{farther,near},state,from,to,3)==near)
  near.position=farther.position
  assert(Rules.nearest(m,{farther,near},state,from,to,3)==near)
 end)
 test("medical eligibility excludes foreign players workers dead full and stale claim",function()
  local a=actor("warrior");assert(Rules.patient(a,1,state))
  for _,kind in {"player","farmer","unknown"}do local b=actor(kind);assert(not Rules.patient(b,1,state))end
  assert(not Rules.patient(actor("warrior",2),1,state));assert(not Rules.patient(actor("warrior",1,0),1,state));assert(not Rules.patient(actor("warrior",1,100),1,state))
  assert(not Rules.patient(a,1,{hospitalLevel=0}));a.neutral=true;assert(not Rules.patient(a,1,state))
 end)
 test("healing clamps simultaneous ticks and rejects dead or replaced life",function()
  local a=actor("warrior",1,98);assert(Rules.apply(a,a.humanoid,12)==2);assert(Rules.apply(a,a.humanoid,5)==0)
  a.humanoid.Health=0;assert(Rules.apply(a,a.humanoid,12)==0)
  a.humanoid.Health=50;assert(Rules.apply(a,{},12)==0 and a.humanoid.Health==50)
 end)
 test("patient ranking uses fraction deficit distance stable slot and excludes self",function()
  local source=actor("medic");local a,b=actor("warrior",1,30,10),actor("ranged",1,40,2)
  assert(Rules.choose(source,{source,b,a},state,45)==a)
  a.humanoid.Health=40;assert(Rules.choose(source,{a,b},state,45)==b)
  a.position=b.position;assert(Rules.choose(source,{a,b},state,45)==b)
  b.humanoid.MaxHealth=200;b.humanoid.Health=80;assert(Rules.choose(source,{a,b},state,45)==b)
  a.position=Vector3.new(100,0,0);b.humanoid.Health=200;assert(not Rules.choose(source,{source,a,b},state,45))
 end)
 test("yard first tick waits two undamaged seconds then one per second without catchup",function()
  local h={Health=50,MaxHealth=100};local r={}
  assert(not Recovery.step(r,h,true,0,nil));assert(not Recovery.step(r,h,true,1,nil))
  assert(Recovery.step(r,h,true,2,nil));assert(not Recovery.step(r,h,true,2.2,nil))
  assert(Recovery.step(r,h,true,3,nil));assert(not Recovery.step(r,h,true,20,nil))
  assert(not Recovery.step(r,h,true,21,nil));assert(Recovery.step(r,h,true,22,nil))
 end)
 test("yard clocks reset on leave damage authority full health and new life",function()
  local h={Health=50,MaxHealth=100};local r={}
  Recovery.step(r,h,true,0,nil);Recovery.step(r,h,true,1,nil);h.Health=40
  assert(not Recovery.step(r,h,true,2,nil));assert(not Recovery.step(r,h,true,3,nil));assert(Recovery.step(r,h,true,4,nil))
  Recovery.step(r,h,false,4.1,nil);assert(not Recovery.step(r,h,true,5,nil))
  h.Health=100;assert(not Recovery.step(r,h,true,6,nil));h.Health=90;assert(not Recovery.step(r,h,true,7,nil))
  assert(not Recovery.step(r,{Health=40,MaxHealth=100},true,8,nil))
 end)
 test("physical yard rejects outside margin and airborne positions and uses medic ring six",function()
  assert(Recovery.contains(Camp.center+Vector3.new(0,2.15,9)))
  assert(not Recovery.contains(Camp.center+Vector3.new(14,2.15,0)))
  assert(not Recovery.contains(Camp.center+Vector3.new(0,12,0)))
  assert(Camp.arrivalIndex("medic")==6 and Camp.arrivalIndex("camp")==8)
 end)
 test("deployment heads to the battlefield even with injured troops behind or in healing range",function()
  local m=actor("medic",1,100,0,500);local f=actor("warrior",1,20,0,520)
  local p=plan({},m,{m,f},false)
  assert(p.goal and p.goal.Z==0 and p.state=="Advancing to battlefield")
  assert(not p.patient and not p.following and not p.retreat)
 end)
 test("battlefield positioning uses the mean of live owned fighters on the field",function()
  local m=actor("medic",1,100,0,100);local a=actor("warrior",1,100,0,20);local b=actor("ranged",1,100,0,60)
  local p=plan({},m,{m,a,b},true)
  assert(p.centroid and math.abs(p.centroid.Z-40)<.001 and p.goal and p.goal.Z<100)
  assert((p.goal-a.position).Magnitude<=45 and (p.goal-b.position).Magnitude<=45)
  assert(not p.following)
 end)
 test("average excludes foreign players medics dead and obsolete civilization troops",function()
  local m=actor("medic",1,100,0,100);local f=actor("warrior",1,100,0,20)
  local foreign=actor("warrior",2,100,0,500);local player=actor("player",1,10,0,500)
  local dead=actor("ranged",1,0,0,600);local stale=actor("warrior",1,100,0,700);stale.civilizationId="britain"
  local moved=actor("warrior",1,100,0,800);moved.plotId=2
  local otherMedic=actor("medic",1,100,0,900)
  local p=plan({},m,{m,f,foreign,player,dead,stale,moved,otherMedic},true)
  assert((p.centroid-f.position).Magnitude<.001)
 end)
 test("a clear position covers all fighters when their spread fits the healing radius",function()
  local m=actor("medic",1,100,0,100)
  local a,b,c=actor("warrior",1,100,0,0),actor("ranged",1,100,0,40),actor("warrior",1,100,0,80)
  local p=plan({},m,{m,a,b,c},true)
  assert(p.goal)
  for _,f in {a,b,c}do assert((p.goal-f.position).Magnitude<=45)end
 end)
 test("one rearward replacement cannot stop support for fighters already on the battlefield",function()
  local m=actor("medic",1,100,0,100);local front=actor("warrior",1,100,0,20);local fresh=actor("ranged",1,100,0,500)
  local p=plan({},m,{m,front,fresh},true)
  assert(p.centroid and p.centroid.Z==20 and p.goal and p.goal.Z<100 and not p.avoiding)
 end)
 test("an army still outside the battlefield leaves the medic's Advance destination active",function()
  local m=actor("medic",1,100,0,120)
  local a,b=actor("warrior",1,100,0,350),actor("ranged",1,100,0,500)
  local p=plan({},m,{m,a,b},true)
  assert(not p.centroid and p.goal and p.goal.Z<120 and p.state=="Advancing to battlefield")
 end)
 test("staggered arrivals join the average individually without waiting for the whole army",function()
  local m=actor("medic",1,100,0,180)
  local a,b,c=actor("warrior",1,100,0,80),actor("ranged",1,100,0,500),actor("warrior",1,100,0,600)
  local p=plan({},m,{m,a,b,c},true)
  assert(p.centroid.Z==80 and p.goal and p.goal.Z<180)
  b.position=Vector3.new(0,2.15,120);p=plan({},m,{m,a,b,c},true)
  assert(p.centroid.Z==100 and p.goal and p.goal.Z<180)
  c.position=Vector3.new(0,2.15,160);p=plan({},m,{m,a,b,c},true)
  assert(p.centroid.Z==120 and p.goal and p.goal.Z<180)
 end)
 test("cleared danger resumes Advance while every replacement is still outside",function()
  local m=actor("medic",1,100,0,120);local fresh=actor("warrior",1,100,0,500)
  local e=actor("warrior",2,100,0,112)
  local p=plan({},m,{m,fresh,e},true)
  assert(p.avoiding and p.goal and p.goal.Z>120)
  m.position=p.goal;p=plan({},m,{m,fresh},true)
  assert(not p.avoiding and p.goal and p.goal.Z<m.position.Z)
 end)
 test("no surviving troops never creates a barracks or reinforcement retreat",function()
  local m=actor("medic",1,100,0,20);local r={origin=Vector3.zero,began=0,withdrawing=true}
  local p=plan(r,m,{m},true);assert(p.goal and p.goal.Z<20 and p.state~="Returning to barracks")
  m.position=Vector3.new(0,2.15,-20);p=plan(r,m,{m},true);assert(not p.goal)
 end)
 test("injuries change healing priority without interrupting centroid movement",function()
  local m=actor("medic",1,100,0,80);local a=actor("warrior",1,100,0,0);local b=actor("ranged",1,100,20,0)
  local p=plan({},m,{m,a,b},true);local goal=p.goal
  a.humanoid.Health=10;p=plan({},m,{m,a,b},true)
  assert((p.goal-goal).Magnitude<.001 and not p.facing)
  assert(Rules.choose(m,{m,a,b},state,100)==a)
 end)
 test("Hold remains stationary with nearby enemies injured fighters and old retreat records",function()
  local m=actor("medic",1,100);local f=actor("warrior",1,20,0,40);local e=actor("warrior",2,100,0,-8)
  local p=plan({origin=Vector3.zero,began=0},m,{m,f,e},true,nil,"hold")
  assert(not p.goal and not p.avoiding and p.state=="Holding")
 end)
 test("actual enemy avoidance permits backward motion without a three-second timeout",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-8);local r={began=-100,origin=Vector3.zero}
  for _=1,3 do
   local p=plan(r,m,{m,e},true)
   assert(p.avoiding and p.goal and p.goal.Z>0 and (p.goal-e.position).Magnitude>8)
  end
  e.position=Vector3.new(0,2.15,-50);local p=plan(r,m,{m,e},true)
  assert(not p.avoiding and not p.goal)
 end)
 test("escape bends toward wounded allies while still increasing enemy distance",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-8)
  local patient=actor("warrior",1,20,35,0)
  local p=plan({},m,{m,e,patient},true)
  assert(p.avoiding and p.goal and p.goal.X>5 and p.goal.Z>5)
  assert((p.goal-e.position).Magnitude>8 and (p.goal-patient.position).Magnitude<35)
 end)
 test("full foreign dead stale and outside troops never attract an escaping medic",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-8)
  local healthy=actor("warrior",1,100,35,0)
  local foreign=actor("ranged",2,20,35,0)
  local dead=actor("warrior",1,0,35,0)
  local stale=actor("warrior",1,20,35,0);stale.civilizationId="britain"
  local moved=actor("ranged",1,20,35,0);moved.plotId=2
  local outside=actor("ranged",1,20,350,0)
  local p=plan({},m,{m,e,healthy,foreign,dead,stale,moved,outside},true)
  assert(p.goal and math.abs(p.goal.X)<.01 and p.goal.Z>9)
 end)
 test("a wounded patient beyond the attacker cannot reverse the escape into danger",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-8)
  local patient=actor("warrior",1,10,0,-35)
  local p=plan({},m,{m,e,patient},true)
  assert(p.goal and p.goal.Z>5 and (p.goal-e.position).Magnitude>8)
 end)
 test("wounded allies behind the pursuer can begin a safe curving escape",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-8)
  local patient=actor("warrior",1,20,0,-35)
  local p=plan({},m,{m,e,patient},true)
  assert(p.goal and math.abs(p.goal.X)>5 and p.goal.Z>5)
 end)
 test("patient attraction cannot send an escape leg through a closer attacker",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-3)
  local patient=actor("warrior",1,10,0,-20)
  local p=plan({},m,{m,e,patient},true,function(point)return if point.Z<-.1 then point else nil end)
  assert(p.avoiding and not p.goal)
 end)
 test("blocked patient-side escapes retain an available safe escape",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-8)
  local patient=actor("warrior",1,20,35,0)
  local p=plan({},m,{m,e,patient},true,function(point)return if point.X<1 then point else nil end)
  assert(p.goal and math.abs(p.goal.X)<.01 and p.goal.Z>9)
 end)
 test("a second nearby enemy blocks the patient-side escape corridor",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-8)
  local flank=actor("ranged",2,100,12,2);local patient=actor("warrior",1,20,35,0)
  local p=plan({},m,{m,e,flank,patient},true)
  assert(p.goal and p.goal.X< -5 and p.goal.Z>5)
 end)
 test("clearance checks do not walk back into the enemy after avoiding it",function()
  local m=actor("medic",1,100,0,30);local f=actor("warrior",1,100,0,0);local e=actor("warrior",2,100,0,10)
  local p=plan({},m,{m,f,e},true)
  if p.goal then
   local d=p.goal-m.position;local t=math.clamp((e.position-m.position):Dot(d)/d:Dot(d),0,1)
   assert((m.position+d*t-e.position).Magnitude>=18)
  end
 end)
 test("blocked movement holds instead of falling back to an unrelated rally",function()
  local m=actor("medic",1,100,0,80);local f=actor("warrior",1,100)
  local p=plan({},m,{m,f},true,function()return nil end);assert(not p.goal)
 end)
 test("rearward averages can be approached laterally without backtracking",function()
  local m=actor("medic",1,100);local f=actor("warrior",1,100,50,30)
  local p=plan({},m,{m,f},true)
  assert(p.goal and p.goal.X>0 and p.goal.Z<=.001)
 end)
 test("a medic already near its troop average stays within healing range",function()
  local m=actor("medic",1,100,0,5);local f=actor("warrior",1,100)
  local p=plan({},m,{m,f},true);assert(not p.goal and not p.avoiding)
 end)
 test("crowd detours preserve forward advance even before reaching the field",function()
  local m=actor("medic",1,100,0,400)
  local p=plan({},m,{m},false)
  assert(p.goal and p.allowsDetour,"Advance lost its crowd movement policy")
  assert(not p.allowsDetour(m.position+Vector3.new(0,0,4)),"Traffic sent the medic backward")
  assert(p.allowsDetour(m.position+Vector3.new(4,0,-1)),"Off-field traffic cannot be passed")
 end)
 test("crowd escape detours cannot cut toward a pursuer",function()
  local m=actor("medic",1,100);local e=actor("warrior",2,100,0,-8)
  local p=plan({},m,{m,e},true)
  assert(p.avoiding and p.allowsDetour)
  assert(not p.allowsDetour(m.position+Vector3.new(0,0,-3)))
  assert(p.allowsDetour(p.goal))
 end)
 return n
end
