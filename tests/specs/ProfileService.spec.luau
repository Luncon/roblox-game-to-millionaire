return function()
	local module=game.ServerScriptService.Game:FindFirstChild("ProfileService")
	assert(module,"Persistent profile sessions are not implemented")
	local Service=require(module)
	local Fake=require(game.ServerStorage.RuntimeTests.FakeProfileStore)
	local count=0
	local function test(name,callback) callback(); count+=1; print("PASS: "..name) end
	local function state(coins,level) return {coins=coins,level=level or 4,weaponLevel=level or 4,armorLevel=level or 4,barracksLevel=level or 4} end
	local function fixture(store,name)
		store=store or Fake.new()
		local time,tokens=100,0
		local options={clock=function() return time end,wait=function(seconds) time+=seconds end,
			leaseSeconds=120,saveInterval=30,retry=3,sessionId=name or "first",newToken=function()
				tokens+=1; return (name or "first").."_"..tokens
			end}
		return Service.new(store,options),store,function(seconds) time+=seconds end,options
	end
	local function waitFor(predicate,description)
		local deadline=os.clock()+3
		repeat if predicate() then return end; task.wait(.01) until os.clock()>deadline
		error("Timed out: "..description)
	end
	test("invalid user identifiers cannot allocate profile keys or datastore operations",function()
		local service,store=fixture()
		for _,id in {0,-1,.5,math.huge,0/0,"101",false,{}} do
			assert(service:load(id).reason=="invalid_user")
		end
		assert(#store.attempts==0 and #store.commits==0)
	end)
	test("successful missing profile becomes writable but unstarted civilizations remain isolated defaults",function()
		local service,store=fixture()
		assert(service:get(101,"sparta")==nil and not service:isWritable(101))
		assert(service:load(101).ok and service:isWritable(101))
		assert(service:status(101).status=="ready")
		local fresh=service:get(101,"sparta")
		assert(fresh.coins==0 and fresh.level==1 and fresh.barracksLevel==1)
		fresh.coins=999
		assert(service:get(101,"sparta").coins==0 and next(service:getAll(101))==nil)
		assert(store:read("User_101").schemaVersion==1)
		assert(service:release(101).ok)
	end)
	test("bounded storage load failures never create writable defaults or replace prior data",function()
		local raw={schemaVersion=1,civilizations={sparta=state(61)},savedAt=90}
		local store=Fake.new({User_101=raw})
		for _=1,3 do store:queue({beforeError="storage unavailable"}) end
		local service=fixture(store)
		assert(not service:load(101).ok and #store.attempts==3 and #store.commits==0)
		assert(service:get(101,"sparta")==nil and not service:isWritable(101))
		assert(not service:set(101,"sparta",state(0,1)))
		service:release(101)
		assert(store:read("User_101").civilizations.sparta.coins==61 and #store.commits==0)
	end)
	test("malformed and future profiles block all writes rather than being repaired to defaults",function()
		for _,raw in {{schemaVersion=2,civilizations={sparta=state(77)}},
			{schemaVersion=1,civilizations={sparta=state(0/0)}},
			{schemaVersion=1,civilizations={unknown=state(22)}}} do
			local store=Fake.new({User_101=raw})
			local service=fixture(store)
			assert(not service:load(101).ok and not service:isWritable(101))
			assert(not service:set(101,"sparta",state(0,1)))
			service:save(101); service:release(101)
			assert(#store.commits==0 and store:read("User_101").schemaVersion==raw.schemaVersion)
		end
	end)
	test("all five progression fields save separately per civilization and restore on a new session",function()
		local service,store=fixture()
		assert(service:load(101).ok)
		local sparta={coins=417,level=4,weaponLevel=3,armorLevel=2,barracksLevel=4,revision=800,plotId=7}
		assert(service:set(101,"sparta",sparta) and service:set(101,"britain",state(8,2)))
		sparta.coins=999
		assert(service:save(101).ok and service:release(101).ok)
		local restored=fixture(store,"second")
		assert(restored:load(101).ok)
		local value=restored:get(101,"sparta")
		assert(value.coins==417 and value.level==4 and value.weaponLevel==3 and value.armorLevel==2 and value.barracksLevel==4)
		assert(value.revision==nil and value.plotId==nil and restored:get(101,"britain").coins==8)
		assert(restored:get(101,"japan").coins==0)
		local all=restored:getAll(101); all.sparta.coins=0
		assert(restored:get(101,"sparta").coins==417)
		assert(restored:release(101).ok)
	end)
	test("invalid civilization and state mutations cannot dirty or replace a loaded profile",function()
		local service,store=fixture()
		assert(service:load(101).ok)
		assert(not service:set(101,"unknown",state(12)))
		assert(not service:set(101,"sparta",{coins=0,level=1,weaponLevel=4,armorLevel=1,barracksLevel=1}))
		assert(next(service:getAll(101))==nil and service:status(101).dirty~=true)
		service:release(101)
		assert(next(store:read("User_101").civilizations)==nil)
	end)
	test("an active owner excludes a second session without replacing its progress or token",function()
		local first,store=fixture()
		assert(first:load(101).ok and first:set(101,"sparta",state(42)))
		assert(first:save(101).ok)
		local token=store:read("User_101").session.token
		local second=fixture(store,"second")
		assert(not second:load(101).ok and not second:isWritable(101))
		assert(store:read("User_101").session.token==token and store:read("User_101").civilizations.sparta.coins==42)
		assert(first:release(101).ok)
	end)
	test("local lease expiry immediately removes read and mutation authority without writing defaults",function()
		local service,store,advance=fixture()
		assert(service:load(101).ok and service:set(101,"sparta",state(33)))
		assert(service:save(101).ok)
		local commits=#store.commits
		advance(120)
		assert(not service:isWritable(101) and service:get(101,"sparta")==nil and service:getAll(101)==nil)
		assert(not service:set(101,"sparta",state(0,1)) and not service:save(101).ok)
		assert(service:status(101).reason=="lease_expired")
		service:release(101)
		assert(#store.commits==commits and store:read("User_101").civilizations.sparta.coins==33)
	end)
	test("expired takeover fences the old writer even after its replacement releases the lease",function()
		local first,store=fixture()
		assert(first:load(101).ok and first:set(101,"sparta",state(10)))
		assert(first:save(101).ok)
		local second,_,advanceSecond=fixture(store,"second")
		advanceSecond(121)
		assert(second:load(101).ok and second:set(101,"sparta",state(99)))
		assert(second:release(101).ok and store:read("User_101").session==nil)
		-- The old process has not observed expiry yet: this must exercise the
		-- stored-token fence, rather than merely short-circuiting a local timer.
		assert(first:isWritable(101) and first:set(101,"sparta",state(11)))
		local commits=#store.commits
		assert(not first:save(101).ok)
		assert(not first:isWritable(101) and not first:set(101,"sparta",state(12)))
		first:release(101)
		assert(store:read("User_101").civilizations.sparta.coins==99 and #store.commits==commits)
	end)
	test("stored-token fencing rejects a still-locally-writable owner during another active lease",function()
		local first,store=fixture()
		assert(first:load(101).ok and first:set(101,"sparta",state(11)))
		assert(first:save(101).ok)
		local second,_,advance=fixture(store,"second")
		advance(121)
		assert(second:load(101).ok and second:set(101,"sparta",state(99)) and second:save(101).ok)
		assert(first:isWritable(101))
		local token,commits=store:read("User_101").session.token,#store.commits
		assert(not first:save(101).ok and not first:isWritable(101))
		assert(store:read("User_101").session.token==token and store:read("User_101").civilizations.sparta.coins==99 and #store.commits==commits)
		assert(second:release(101).ok)
	end)
	test("failed save retains dirty live progress and reports failure until a later successful retry",function()
		local service,store=fixture()
		assert(service:load(101).ok and service:set(101,"sparta",state(47)))
		for _=1,3 do store:queue({beforeError="save service unavailable"}) end
		assert(not service:save(101).ok and service:status(101).reason=="save_failed")
		assert(service:status(101).dirty==true and service:get(101,"sparta").coins==47)
		assert(store:read("User_101").civilizations.sparta==nil)
		assert(service:save(101).ok and service:status(101).dirty~=true)
		assert(store:read("User_101").civilizations.sparta.coins==47 and service:release(101).ok)
	end)
	test("commit-then-throw load and save retries preserve one session and the exact final state",function()
		local service,store=fixture()
		store:queue({afterError="unknown load outcome"})
		assert(service:load(101).ok and service:isWritable(101))
		local token=store:read("User_101").session.token
		assert(service:set(101,"sparta",state(73)))
		store:queue({afterError="unknown save outcome"})
		assert(service:save(101).ok)
		assert(store:read("User_101").civilizations.sparta.coins==73 and store:read("User_101").session.token==token)
		assert(service:status(101).dirty~=true and service:release(101).ok)
	end)
	test("uncertain release outcome never reports success or reacquires an already unlocked profile",function()
		local service,store=fixture()
		assert(service:load(101).ok and service:set(101,"sparta",state(81)))
		store:queue({afterError="release committed but response was lost"})
		local released=service:release(101)
		assert(not released.ok and not service:isWritable(101))
		assert(store:read("User_101").session==nil and store:read("User_101").civilizations.sparta.coins==81)
		local commits=#store.commits
		assert(not service:save(101).ok and not service:set(101,"sparta",state(0,1)))
		assert(#store.commits==commits,"Uncertain release reacquired ownership")
		local nextSession=fixture(store,"next")
		assert(nextSession:load(101).ok and nextSession:get(101,"sparta").coins==81)
		assert(nextSession:release(101).ok)
	end)
	test("replayed update callbacks do not duplicate progress or corrupt session ownership",function()
		local service,store=fixture()
		store:queue({replay=3})
		assert(service:load(101).ok)
		assert(service:set(101,"sparta",state(19)))
		store:queue({replay=3})
		assert(service:save(101).ok and store.callbacks>=8)
		assert(service:get(101,"sparta").coins==19 and store:read("User_101").civilizations.sparta.coins==19)
		assert(service:release(101).ok)
	end)
	test("mutations arriving during a yielding save remain dirty until the final latest-state flush",function()
		local service,store=fixture()
		assert(service:load(101).ok and service:set(101,"sparta",state(10)))
		local gate=store:gateNext()
		local result
		task.spawn(function() result=service:save(101) end)
		waitFor(function() return gate.entered end,"save enters storage")
		assert(service:set(101,"sparta",state(20)))
		gate:release()
		waitFor(function() return result~=nil end,"first save completes")
		assert(result.ok and store:read("User_101").civilizations.sparta.coins==10)
		assert(service:status(101).dirty==true and service:get(101,"sparta").coins==20)
		assert(service:release(101).ok and store:read("User_101").civilizations.sparta.coins==20)
	end)
	test("concurrent saves serialize complete retries and persist the latest queued snapshot",function()
		local service,store=fixture()
		assert(service:load(101).ok and service:set(101,"sparta",state(10)))
		local gate=store:gateNext()
		local first,second
		task.spawn(function() first=service:save(101) end)
		waitFor(function() return gate.entered end,"older save enters storage")
		assert(service:set(101,"sparta",state(30)))
		task.spawn(function() second=service:save(101) end)
		task.wait(.05)
		assert(second==nil,"Newer save bypassed the older in-flight operation")
		gate:release()
		waitFor(function() return first~=nil and second~=nil end,"ordered saves finish")
		assert(first.ok and second.ok and store:read("User_101").civilizations.sparta.coins==30)
		assert(service:status(101).dirty~=true and service:release(101).ok)
	end)
	test("departure during load closes the late-acquired lease without initializing writable data",function()
		local service,store=fixture()
		local gate=store:gateNext()
		local loaded,released
		task.spawn(function() loaded=service:load(101) end)
		waitFor(function() return gate.entered end,"loading session waits on storage")
		task.spawn(function() released=service:release(101) end)
		task.wait(.03)
		assert(not service:isWritable(101))
		gate:release()
		waitFor(function() return loaded~=nil and released~=nil end,"late load and release finish")
		assert(released.ok and not service:isWritable(101) and service:get(101,"sparta")==nil)
		assert(store:read("User_101").session==nil)
	end)
	test("duplicate departure and shutdown flush once and never revive a closed profile",function()
		local service,store=fixture()
		assert(service:load(101).ok and service:set(101,"sparta",state(58)))
		assert(service:release(101).ok)
		local commits=#store.commits
		assert(service:release(101).ok)
		assert(service:shutdown().ok)
		assert(#store.commits==commits and store:read("User_101").civilizations.sparta.coins==58)
		assert(not service:isWritable(101) and not service:set(101,"sparta",state(0,1)))
	end)
	test("periodic autosave persists dirty progress before shutdown releases the session",function()
		local store=Fake.new()
		local time=100
		local service=Service.new(store,{clock=function() return time end,wait=function(seconds) time+=seconds; task.wait(.01) end,
			leaseSeconds=120,saveInterval=30,retry=3,sessionId="autosave",newToken=function() return "autosave-token" end})
		assert(service:load(101).ok and service:set(101,"sparta",state(27)))
		service:startAutosave()
		waitFor(function() return store:read("User_101").civilizations.sparta~=nil end,"periodic save")
		assert(store:read("User_101").civilizations.sparta.coins==27)
		assert(service:shutdown().ok and store:read("User_101").session==nil)
	end)
	return count
end
